{
  "name": "@actalk/inkos-studio",
  "version": "2.0.0",
  "description": "InkOS Studio web workbench for novels, short fiction, scripts, interactive film and worlds, and translation",
  "type": "module",
  "main": "dist/api/index.js",
  "types": "dist/api/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Narcooo/inkos.git",
    "directory": "packages/studio"
  },
  "scripts": {
    "prepack": "npm run build",
    "dev": "INKOS_STUDIO_PORT=4569 tsx watch --clear-screen=false src/api/index.ts & vite --host 127.0.0.1 --port 4567 ; kill %1 2>/dev/null",
    "dev:client": "vite --host 127.0.0.1 --port 4567",
    "dev:server": "INKOS_STUDIO_PORT=4569 tsx watch src/api/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node ../../scripts/clean-package-dist.mjs api && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:flows": "vitest run src/api/runtime.flow.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@actalk/inkos-core": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@playwright/test": "^1.61.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@xyflow/react": "^12.11.1",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
