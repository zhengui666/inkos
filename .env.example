# InkOS 2 uses official pi-ai authentication: inkos models login <provider>.
# Project model selection: inkos models set <provider> <model-id>.
# These optional variables must be exported by the shell/service;
# InkOS does not automatically load a .env file.

# Installed browser for local browser/e2e checks (optional)
# INKOS_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable

# Retained thin image service, if configured in inkos.json.media (optional)
# INKOS_COVER_API_KEY=
# INKOS_COVER_BASE_URL=
# INKOS_COVER_ENDPOINT=
